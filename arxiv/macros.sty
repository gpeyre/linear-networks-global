\newcommand{\Sqq}{\Sigma^q}
\newcommand{\Spos}{\Sigma^{(u,v)}}
\newcommand{\Svel}{\Sigma^{(p,q)}}

% Accent only the base of these block macros; preserve all other arguments.
% Use \dot\Svu_t or \dot{\Svu}_t, keeping the subscript outside the argument.
\ExplSyntaxOn
\cs_new_eq:NN \cov_original_dot:n  \dot
\cs_new_eq:NN \cov_original_ddot:n \ddot
\cs_new_protected:Npn \cov_accent:Nn #1#2
  {
    \tl_if_single_token:nTF {#2}
      {
        \clist_if_in:nnTF
          {
            \Suu, \Suv, \Svu, \Svv,
            \tSuu, \tSuv, \tSvu, \tSvv,
            \Sppos, \Sqp, \Squ, \Svp, \Sqq,
            \Spos, \Svel
          }
          {#2}
          { \expandafter #1 #2 }
          { #1 {#2} }
      }
      { #1 {#2} }
  }
\RenewDocumentCommand{\dot}{m}
  { \cov_accent:Nn \cov_original_dot:n {#1} }
\RenewDocumentCommand{\ddot}{m}
  { \cov_accent:Nn \cov_original_ddot:n {#1} }
\ExplSyntaxOff

