% Group the tilde base so an outer derivative accent excludes the scripts.
\newcommand{\tSuu}{{\widetilde{\Sigma}}^u}
\newcommand{\tSuv}{{\widetilde{\Sigma}}^{uv}}
\newcommand{\tSvu}{{\widetilde{\Sigma}}^{vu}}
\newcommand{\tSvv}{{\widetilde{\Sigma}}^v}
